# RAG Application Configuration

# LLM Providers (Configure at least one to run LLM-based QA and evaluation)
# --------------------------------------------------------------------------
# Gemini API Key (Recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# Choice of LLM provider: "gemini" or "openai" or "mock"
# If no API key is provided, the system defaults to "mock" mode
LLM_PROVIDER=mock

# Retrieval & Chunking Settings
# -----------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=50
VECTOR_DB_DIR=data/vectorstore
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
TOP_K_RETRIEVAL=6
TOP_K_RERANK=3

# Web Server Settings
# -------------------
HOST=127.0.0.1
PORT=8000
# Comma-separated list of origins allowed by CORS (set your real frontend
# origin(s) in production). Defaults to common localhost dev origins.
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:3000

# Rate Limiting (login/signup, per client IP)
# -------------------------------------------
RATE_LIMIT_AUTH_ATTEMPTS=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=60

# Redis (optional — leave empty to use in-memory caches and limits)
# -----------------------------------------------------------------
# When set and reachable, the semantic cache, retrieval cache, and rate
# limiter become shared across workers. Unreachable Redis falls back to
# memory automatically.
REDIS_URL=
REDIS_RETRIEVAL_TTL_SECONDS=3600

# Authentication Settings
# -----------------------
# SQLite by default; for PostgreSQL:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/omnicorp
DATABASE_URL=sqlite:///data/auth.db
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_generate_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
